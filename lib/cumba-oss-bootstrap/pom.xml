<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cumba-oss-bootstrap</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-commons-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!--
        REQUIRED by Maven Central, and it must be declared HERE: <name> is
        one of the few POM elements Maven does NOT inherit from the parent,
        so a module without its own name publishes a nameless artifact and
        the Central bundle is rejected with "Project name is missing".
    -->
    <name>Cumba OSS Commons :: Bootstrap Launcher</name>
    <!--
        Declared explicitly rather than inherited. The parent carries
        child.project.url.inherit.append.path="false", which correctly stops the
        <scm> URLs appending the module path but was measured NOT to take effect
        for the project <url> here (Maven 3.9.16): the effective pom still read
        .../cumba-oss-commons/lib/<module>, a 404. An explicit value removes the
        dependence on that behaviour entirely.
    -->
    <url>https://github.com/cumba-oss/cumba-oss-commons</url>
    <inceptionYear>2026</inceptionYear>
    <description>
        Dependency-free launcher. Reads a sidecar INI-style config named
        after the jar it was loaded from (foo.jar -> foo.conf, sitting next
        to the jar), applies system properties (with environment / prior-
        property interpolation), builds a globbed and de-duplicated
        classpath, and reflectively invokes a configured main class inside
        an isolated URLClassLoader. JDK-only; nothing ships in libs/.
    </description>
    <organization>
        <name>P300</name>
    </organization>

    <properties>
        <!-- Repo-root anchor, depth 2 (see the root pom). -->
        <repo.root.dir>${project.basedir}/../..</repo.root.dir>

        <mockito.agent>-javaagent:${org.mockito:mockito-core:jar}</mockito.agent>
        <!-- New module: enforce the plan's 0.85 line-coverage target via the
             module's own floor, so a plain full-reactor `verify` gates it
             without the global -Djacoco.line.coverage clobber trap. -->
        <jacoco.line.coverage>0.85</jacoco.line.coverage>

        <!--
            Mutation floors, measured on THIS subset. This module is the process entry point of
            two shipped distributions, so it carries its own floors: the root pom's inherited
            test-strength floor of 0 cannot fail at any score, so the glob and blank-entry tests
            that guard the ported classpath fixes would hold nothing in place.

            Each floor is the measured figure minus about two points. ⚠ pitest scores
            TIMED_OUT and RUN_ERROR as kills, so the honest KILLED-only rate is the one
            to reason about; the floors are set against what pitest itself compares, which is
            the headline, rounded to an integer.

            ⛔ A floor is never lowered. Never pass -Dpitest.mutation.threshold or
            -Djacoco.line.coverage on the command line; a CLI -D clobbers every module at once.
        -->
        <pitest.mutation.target>95</pitest.mutation.target>
        <pitest.coverage.target>91</pitest.coverage.target>
        <pitest.test.strength.target>96</pitest.test.strength.target>

        <!--
            POLICY (PLAN-single-instance-folder-open SI11, owner-approved 2026-10-09): the ONE
            class excluded from the floors above is the Windows foreign-function binding
            WindowsForegroundGrant - a user32 downcall that a Linux build host can never
            execute. It holds the lookup, the handle and the call, no branch. Everything that
            decides anything (platform selection, the lock, the directory checks, every
            time-out) is injected and runs on Linux CI, so nothing else is excluded.
        -->
        <jacoco.coverage.excludes>**/net/cumba/bootstrap/instance/WindowsForegroundGrant.class</jacoco.coverage.excludes>
        <pitest.excludedClasses>net.cumba.bootstrap.instance.WindowsForegroundGrant</pitest.excludedClasses>
        <!--
            Fully qualified (a simple name matches nothing). The two tests fork JVMs: five
            launchers per run (the multi-process hand-off) and a -Xlog:class+load run (the
            no-key class-load proof). Neither covers a production line in the test JVM, and a
            fork per mutant would only time out; surefire runs them, pitest does not.
        -->
        <pitest.excludedTestClasses>net.cumba.bootstrap.instance.MultiProcessHandOffTest,net.cumba.bootstrap.NoKeyClassLoadTest</pitest.excludedTestClasses>
    </properties>

    <dependencies>

        <!-- NO runtime dependencies: JDK only. JSpecify is compile-time only
             (provided scope), so the runtime classpath stays JDK-only. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>


        <!--
            TEST SCOPE ONLY - the shipped jar stays JDK-only.

            jimfs supplies an in-memory FileSystem whose Windows configuration
            enforces the real Windows path rules, including the reserved-character
            set (<>:"|?*) that makes Path.of reject every glob classpath entry.
            That is the ONLY way this Linux build host can execute the Windows
            half of ClasspathBuilder; without it the portability fix would ship
            reasoned but never run. Verified faithful against the JDK sources
            before use: jimfs throws InvalidPathException for '*'/'?' exactly as
            sun.nio.fs.WindowsPathParser does, and its glob compiler maps '/'
            onto the '\' separator while treating a literal '\' as the glob
            escape, exactly as sun.nio.fs.Globs does.

            The version is managed in the root pom (dependency.jimfs.version).
        -->
        <dependency>
            <groupId>com.google.jimfs</groupId>
            <artifactId>jimfs</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Tests never reach the real home: the single-instance tests create
                        instance/ directories, lock files and sockets under the scope they are
                        given, and nothing may land in ~/.cumbaDataBrowser. The redirect is
                        appended to the parent's variables (combine.children="append"; checked
                        with help:effective-pom) and repeated in the Pitest profile below,
                        whose minions inherit nothing from here. TestHomeRedirectTest is the
                        guard; the real home is passed as realUserHome from the Maven JVM.
                    -->
                    <systemPropertyVariables combine.children="append">
                        <user.home>${project.build.directory}/test-home</user.home>
                        <realUserHome>${user.home}</realUserHome>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>net.cumba.bootstrap.Bootstrap</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Activated with the root pom's profile of the same id (-P Pitest). -->
            <id>Pitest</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <!-- The home redirect for the minions (see surefire above). -->
                            <jvmArgs combine.children="append">
                                <jvmArg>-Duser.home=${project.build.directory}/test-home</jvmArg>
                                <jvmArg>-DrealUserHome=${user.home}</jvmArg>
                            </jvmArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <reporting>
    </reporting>

</project>
