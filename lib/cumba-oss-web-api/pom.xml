<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cumba-oss-web-api</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-commons-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!--
        REQUIRED by Maven Central, and it must be declared HERE: <name> is
        one of the few POM elements Maven does NOT inherit from the parent,
        so a module without its own name publishes a nameless artifact and
        the Central bundle is rejected with "Project name is missing".
    -->
    <name>Cumba OSS Commons :: Web API Client</name>
    <!--
        Declared explicitly rather than inherited. The parent carries
        child.project.url.inherit.append.path="false", which correctly stops the
        <scm> URLs appending the module path but was measured NOT to take effect
        for the project <url> here (Maven 3.9.16): the effective pom still read
        .../cumba-oss-commons/lib/<module>, a 404. An explicit value removes the
        dependence on that behaviour entirely.
    -->
    <url>https://github.com/cumba-oss/cumba-oss-commons</url>
    <inceptionYear>2026</inceptionYear>
    <description>
        Lightweight HATEOAS / JSON-over-HTTP client toolkit: Link,
        ApiResource, AbstractApiClient, JdkHttpTransport, FileApiCache,
        and friends. Used by cumba-oss-cdisc-library as its REST plumbing.
    </description>
    <organization>
        <name>P300</name>
    </organization>

    <properties>
        <mockito.agent>-javaagent:${org.mockito:mockito-core:jar}</mockito.agent>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- JSpecify nullability annotations (NullAway). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <reporting>
    </reporting>

</project>
