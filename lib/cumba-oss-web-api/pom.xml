<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cumba-oss-web-api</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-commons-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!--
        REQUIRED by Maven Central, and it must be declared HERE: <name> is
        one of the few POM elements Maven does NOT inherit from the parent,
        so a module without its own name publishes a nameless artifact and
        the Central bundle is rejected with "Project name is missing".
    -->
    <name>Cumba OSS Commons :: Web API Client</name>
    <!--
        Declared explicitly rather than inherited. The parent carries
        child.project.url.inherit.append.path="false", which correctly stops the
        <scm> URLs appending the module path but was measured NOT to take effect
        for the project <url> here (Maven 3.9.16): the effective pom still read
        .../cumba-oss-commons/lib/<module>, a 404. An explicit value removes the
        dependence on that behaviour entirely.
    -->
    <url>https://github.com/cumba-oss/cumba-oss-commons</url>
    <inceptionYear>2026</inceptionYear>
    <description>
        Lightweight HATEOAS / JSON-over-HTTP client toolkit: Link,
        ApiResource, AbstractApiClient, JdkHttpTransport, FileApiCache,
        and friends. Used by cumba-oss-cdisc-library as its REST plumbing.
    </description>
    <organization>
        <name>P300</name>
    </organization>

    <properties>
        <mockito.agent>-javaagent:${org.mockito:mockito-core:jar}</mockito.agent>

        <!-- Exclude the OpenAPI-spec splitter dev tool from mutation; it is a
             file-I/O main() that pollutes the CWD when mutated. -->
        <pitest.excludedClasses>net.cumba.web.api.tools.SplitOpenApiSpec*</pitest.excludedClasses>

        <!--
            Quality floors for this module, from a COLD full-module measurement on 2026-09-11,
            re-measured cold the same day after the resource-agreement and cache-key rulings:

              932 mutants - 920 KILLED, 11 SURVIVED, 1 NO_COVERAGE, 0 TIMED_OUT
              mutation kill 98.71 %  ·  test strength 98.82 %
              pitest line coverage (mutated classes) 1289/1318 = 97.80 %
              JaCoCo line 0.9792

            Each floor is the measured figure minus two points, and each is set against the
            KILLED-ONLY rate: pitest scores TIMED_OUT and RUN_ERROR as kills, so a floor set
            against its headline can be met without a single new assertion. There were no
            timeouts here, so the honest and the headline rates coincide - which is why they
            can be compared directly with a later run's headline without further arithmetic.

            ⛔ A FLOOR IS NEVER LOWERED. If a change drops this module below one of these, the
            change is wrong or its tests are missing - not the floor. Re-basing a gate downward
            every time it bites is how a gate stops being one.

            All 12 residual mutants are accounted for: ten are argued EQUIVALENT (five NodeList
            loop bounds that cannot differ because item() is null past the end and every body is
            instanceof-guarded; two no-op boolean-return mutants on literal `return true` /
            `return false`; the b<0 byte scan, which differs only at b==0 where both branches
            agree; Link.id's aIndex>0, unreachable because aIndex==0 returns earlier; and
            shortenCacheKey's loop bound, which the key-length arithmetic makes unreachable), and
            two are the file-handle close in GzipFileApiCache.openCacheFileStream, which has no
            seam through which a test could observe it.

            ⚠ The measurement and the residual accounting are an INTERNAL record; this repository
            carries the numbers, not the path to them. The module is a real twin (26 main files on
            both sides) and every test behind these figures is present here, so they apply
            unchanged.
        -->
        <pitest.mutation.target>96</pitest.mutation.target>
        <pitest.coverage.target>95</pitest.coverage.target>
        <pitest.test.strength.target>96</pitest.test.strength.target>
        <jacoco.line.coverage>0.95</jacoco.line.coverage>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- JSpecify nullability annotations (NullAway). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <reporting>
    </reporting>

</project>
